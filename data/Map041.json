"]},{"code":401,"indent":0,"parameters":["\\tgt[this]Anyways, the reason I wanted to talk, is to"]},{"code":401,"indent":0,"parameters":["discuss my plans for you three."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]You are able to kill vampires, and in addition to"]},{"code":401,"indent":0,"parameters":["that, I've heard rumours that you know magic."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]Not the same way \\N[11] uses magic, no;"]},{"code":401,"indent":0,"parameters":["the genuine way."]},{"code":101,"indent":0,"parameters":["ToiPortraits",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]That is correct."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]I speak for the country when I say this, we need"]},{"code":401,"indent":0,"parameters":["your help annihilating the last remaining ((Thay Mau))."]},{"code":101,"indent":0,"parameters":["CardaniPortraits",5,0,2,"\\N[3]"]},{"code":401,"indent":0,"parameters":["\\tgt[a3]A ((Thay Mau))..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]I'm afraid our last war against the vampires, didn't"]},{"code":401,"indent":0,"parameters":["exterminate all of them.\\!"]},{"code":401,"indent":0,"parameters":["One survived the war."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]Our sources say it's been raising an army of ((Renfield))s"]},{"code":401,"indent":0,"parameters":["the past decades."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]What you three fought, was a vampire that just turned.\\!"]},{"code":401,"indent":0,"parameters":["A weakling compared to what we must face."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]The ((Thay Mau)) turned Apreh into a ((Renfield)),"]},{"code":401,"indent":0,"parameters":["which must mean it can't be far away."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]I want you three to enter Hang Cave.\\!"]},{"code":401,"indent":0,"parameters":["There's been spotted suspecious activities there, and our"]},{"code":401,"indent":0,"parameters":["scouts say they look like ((Renfield))s."]},{"code":101,"indent":0,"parameters":["HoaPortraits",3,0,2,"\\N[2]"]},{"code":401,"indent":0,"parameters":["\\tgt[a2]No."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]Excuse me? No?"]},{"code":101,"indent":0,"parameters":["HoaPortraits",3,0,2,"\\N[2]"]},{"code":401,"indent":0,"parameters":["\\tgt[a2]No, we have to find mom!\\!"]},{"code":401,"indent":0,"parameters":["She's our priority number one!"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]We can send a search party for your mom."]},{"code":101,"indent":0,"parameters":["HoaPortraits",6,0,2,"\\N[2]"]},{"code":401,"indent":0,"parameters":["\\tgt[a2]\\Effect<SoftShake>No!"]},{"code":101,"indent":0,"parameters":["ToiPortraits",2,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]Leig, we understand vampires are a threat"]},{"code":401,"indent":0,"parameters":["to the country."]},{"code":101,"indent":0,"parameters":["ToiPortraits",3,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]But when there's a chance to have mom back..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]Hmm... I see."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]Then you leave me no choice.\\!"]},{"code":401,"indent":0,"parameters":["If you three won't cooperate, then I must give you a reason to."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]You three will be considered enemies of the country,"]},{"code":401,"indent":0,"parameters":["if you choose not to join us."]},{"code":101,"indent":0,"parameters":["ToiPortraits",5,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]\\Effect<Shake>Are you crazy?!"]},{"code":101,"indent":0,"parameters":["ToiPortraits",5,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]\\Effect<SoftShake>How would that help you in any way!"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]You will be our prisoners until you agree to help."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Leig"]},{"code":401,"indent":0,"parameters":["\\tgt[this]We will send a party to find your mother, still.\\!"]},{"code":401,"indent":0,"parameters":["Your own journey isn't valueless to us, but there is a priority here."]},{"code":101,"indent":0,"parameters":["ToiPortraits",2,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]I see, so that's how you play."]},{"code":101,"indent":0,"parameters":["ToiPortraits",2,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]\\N[2], I know you want to see mom as much as I do."]},{"code":101,"indent":0,"parameters":["HoaPortraits",4,0,2,"\\N[2]"]},{"code":401,"indent":0,"parameters":["\\tgt[a2]\\N[1], don't end it now."]},{"code":101,"indent":0,"parameters":["ToiPortraits",2,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\\tgt[a1]That's why we're... \\Effect<Shake>GOING TO RUN!"]},{"code":212,"indent":0,"parameters":[0,125,false]},{"code":357,"indent":0,"parameters":["Tyruswoo_FollowerControl","chase","Chase",{"target":"all"}]},{"code":657,"indent":0,"parameters":["target = all"]},{"code":357,"indent":0,"parameters":["Tyruswoo_FollowerControl","leader","Leader",{}]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":29,"parameters":[6],"indent":null},{"code":30,"par