{"id":6,"name":"Anna","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"VillagersF2","direction":2,"pattern":1,"characterIndex":6},"list":[{"code":108,"indent":0,"parameters":["<trigger_always>"]},{"code":111,"indent":0,"parameters":[0,162,1]},{"code":121,"indent":1,"parameters":[162,162,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":1,"parameters":["\\tgt[this]Hello young adventurers, how did you enter my house?"]},{"code":111,"indent":1,"parameters":[2,"A",0]},{"code":101,"indent":2,"parameters":["HoaPortraits",2,0,2,"\\N[2]"]},{"code":401,"indent":2,"parameters":["\\tgt[a2]There's no time for that!\\!"]},{"code":401,"indent":2,"parameters":["Someone told us you know magic!"]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]Ah, Ietnarad that blabbermouth."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]To be truthful, I do not have the ability to perform magic."]},{"code":101,"indent":2,"parameters":["HoaPortraits",4,0,2,"\\N[2]"]},{"code":401,"indent":2,"parameters":["\\tgt[a2]Aww..."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]I, however, have studies the innerworks of magic."]},{"code":101,"indent":2,"parameters":["ToiPortraits",1,0,2,"\\N[1]"]},{"code":401,"indent":2,"parameters":["\\tgt[a1]We'd be honored to learn magic from you, Anna."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]Oh? You young adventurers are interested in the"]},{"code":401,"indent":2,"parameters":["nature of magic?"]},{"code":101,"indent":2,"parameters":["ToiPortraits",1,0,2,"\\N[1]"]},{"code":401,"indent":2,"parameters":["\\tgt[a1]Not only academics, but also how to properly"]},{"code":401,"indent":2,"parameters":["take advantage of our gift."]},{"code":101,"indent":2,"parameters":["HoaPortraits",2,0,2,"\\N[2]"]},{"code":401,"indent":2,"parameters":["\\tgt[a2]Like this!"]},{"code":212,"indent":2,"parameters":[-1,41,false]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]I can't believe my eyes...\\!"]},{"code":401,"indent":2,"parameters":["You adventurers are mages."]},{"code":101,"indent":2,"parameters":["EdocPortraits",0,0,2,"\\N[4]"]},{"code":401,"indent":2,"parameters":["\\tgt[a4]Not all of us."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]I thought the art of magic was long gone..."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]All we have now, are people who can cast the essence of magic."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]Such as \\N[11].\\!"]},{"code":401,"indent":2,"parameters":["She's no mage, but using proper equipment and lifeforce, she can"]},{"code":401,"indent":2,"parameters":["cast powerful spells."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]The only genuine mages I knew was \\N[6]."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]Unfortunately I heard she passed away some years ago."]},{"code":101,"indent":2,"parameters":["ToiPortraits",1,0,2,"\\N[1]"]},{"code":401,"indent":2,"parameters":["\\tgt[a1]Anna, we are \\N[6]'s children.\\!"]},{"code":401,"indent":2,"parameters":["We also possess the ability to cast magic."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]..."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]My goodness... I see it now."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]You... you look like a child version of \\N[6]."]},{"code":101,"indent":2,"parameters":["HoaPortraits",5,0,2,"\\N[2]"]},{"code":401,"indent":2,"parameters":["\\tgt[a2]That's because \\N[6]'s my mom!"]},{"code":101,"indent":2,"parameters":["HoaPortraits",0,0,2,"\\N[2]"]},{"code":401,"indent":2,"parameters":["\\tgt[a2]Also mom's alive. \\N[3] said so."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]We have much to talk about, young adventurers."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]When you have time, let's sit down and have a long talk."]},{"code":119,"indent":2,"parameters":["Listen"]},{"code":0,"indent":2,"parameters":[]},{"code":411,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["ToiPortraits",1,0,2,"\\N[1]"]},{"code":401,"indent":2,"parameters":["\\tgt[a1]The door's unlocked."]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]Hmm... as long as you don't steal from a poor old lady.\\!"]},{"code":401,"indent":2,"parameters":["You're free to roam around."]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":111,"indent":1,"parameters":[2,"A",0]},{"code":101,"indent":2,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":2,"parameters":["\\tgt[this]Are you ready to hear the full story?"]},{"code":118,"indent":2,"parameters":["Listen"]},{"code":102,"indent":2,"parameters":[["Listen","Leave"],-1,-1,2,0]},{"code":402,"indent":2,"parameters":[0,"Listen"]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]\\N[6], your mom, is, or was, the only bloodline left who"]},{"code":401,"indent":3,"parameters":["could cast magic."]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]The origin of her magic is still unknown, and people"]},{"code":401,"indent":3,"parameters":["are still researching its origin."]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]However, magic is now a rather unknown phenomena"]},{"code":401,"indent":3,"parameters":["among regular folkes."]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]It is believed her magic was greatly used during the"]},{"code":401,"indent":3,"parameters":["times, when us humans fought vampires."]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]What we archived from the war, vaguely mentions magic.\\!"]},{"code":401,"indent":3,"parameters":["It was always thought to be an exaggeration from the writers."]},{"code":101,"indent":3,"parameters":["ToiPortraits",0,0,2,"\\N[1]"]},{"code":401,"indent":3,"parameters":["\\tgt[a1]I don't get it.\\!"]},{"code":401,"indent":3,"parameters":["Why do you call it \\N[6]'s magic, when this fight against vampires"]},{"code":401,"indent":3,"parameters":["was centuries ago?"]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]Much of history was lost between then and now,"]},{"code":401,"indent":3,"parameters":["and we believe magic was more commonly used back then."]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]Even when I was as young as you, magic was only a myth."]},{"code":101,"indent":3,"parameters":["",0,0,2,"Anna"]},{"code":401,"indent":3,"parameters":["\\tgt[this]That was until I became your mother's teacher."]},{"code":101,"indent":3